SOURCE_LANGUAGE=auto
TARGET_LANGUAGE=vi
TRANSLATION_PROVIDER=google
TRANSLATION_PROVIDERS=google
TRANSLATION_SERVER_URL=http://127.0.0.1:8000
SCREEN_TRANSLATOR_CACHE=%USERPROFILE%\.screen_translator\translations.db
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\google-service-account.json
SCREEN_TRANSLATOR_DEBUG=false
SCREEN_TRANSLATOR_DEBUG_OVERLAY=false
SCREEN_TRANSLATOR_GAMING_OVERLAY_TTL_MS=0
SCREEN_TRANSLATOR_GAMING_OCR_CACHE_TTL_MS=10000
SCREEN_TRANSLATOR_GAMING_WARM_CACHE=true
SCREEN_TRANSLATOR_GAMING_HOTKEY=Ctrl+Shift+T
SCREEN_TRANSLATOR_GAMING_DISMISS_HOTKEY=Esc
SCREEN_TRANSLATOR_OVERLAY_MAX_WIDTH=500
SCREEN_TRANSLATOR_OVERLAY_FONT_SIZE=18
SCREEN_TRANSLATOR_OVERLAY_PANEL_OPACITY=150
OVERLAY_INLINE_MIN_FONT_SIZE=8
OVERLAY_INLINE_MAX_FONT_SIZE=22
OVERLAY_INLINE_PADDING=6
OVERLAY_INLINE_ALLOW_EXPAND_RATIO=1.5
OVERLAY_INLINE_MAX_LINES=4
OVERLAY_INLINE_LONG_TEXT_FALLBACK=none
SCREEN_TRANSLATOR_READING_INTERVAL_MS=750
SCREEN_TRANSLATOR_READING_CHANGE_THRESHOLD=0.02
SCREEN_TRANSLATOR_READING_MISSING_TIMEOUT_MS=2000
SCREEN_TRANSLATOR_READING_MIN_CONFIDENCE=0.5
SPEED_PROFILE=balanced
SCREEN_TRANSLATOR_FAST_OCR=true
OCR_MAX_IMAGE_WIDTH=800
OCR_MIN_CONFIDENCE=0.60
OCR_MIN_BLOCK_WIDTH=8
OCR_MIN_BLOCK_HEIGHT=8
OCR_MAX_BLOCKS_GAMING=5
SCREEN_TRANSLATOR_ZONE_MIN_OCR_INTERVAL_MS=500
SCREEN_TRANSLATOR_TRANSLATION_DEBOUNCE_MS=300
SCREEN_TRANSLATOR_SHOW_TRANSLATING_PLACEHOLDER=true
OCR_HISTORY_CACHE_SIZE=256
OCR_HISTORY_CACHE_TTL_MS=300000
OCR_STABILITY_FRAMES=2
